page { background: #f6f7f8; color: #242629; font-family: -apple-system, 'PingFang SC', sans-serif; font-size: 28rpx; }
.page { padding: 32rpx 28rpx 60rpx; }
.card { background: white; border: 1rpx solid #e5e9ed; border-radius: 12rpx; padding: 28rpx; margin-bottom: 20rpx; }
.kicker { color: #344c43; font-size: 22rpx; letter-spacing: 3rpx; }
.heading { font-size: 44rpx; font-weight: 650; margin: 16rpx 0; }
.muted { color: #62666b; font-size: 25rpx; line-height: 1.7; }
.empty { padding: 64rpx 24rpx; text-align: center; color: #62666b; }
.paper-meta { display: flex; justify-content: space-between; gap: 12rpx; color: #62666b; font-size: 22rpx; }
.paper-title { font-size: 32rpx; line-height: 1.5; font-weight: 600; margin: 18rpx 0; }
.paper-intro { color: #62666b; line-height: 1.7; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.actions { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 24rpx; }
button { font-size: 24rpx; border-radius: 8rpx; }
button::after { border: none; }
.actions button { margin: 0; padding: 0 18rpx; background: #f0f2f1; color: #344c43; line-height: 64rpx; }
.actions .selected { background: #344c43; color: white; }
.primary-button { background: #344c43; color: white; margin-top: 20rpx; }
.link { color: #344c43; }
.status { color: #62666b; text-align: center; padding: 28rpx; }
.tabs { display: flex; gap: 16rpx; margin: 28rpx 0; }
.tabs button { flex: 1; margin: 0; color: #62666b; background: white; }
.tabs .active { background: #344c43; color: white; }
